  "layoutRules": {
    "sectionBackgroundChain": {
      "mode": "layered-section-after",
      "rules": [
        "Each section owns its content layer and an after/background layer.",
        "The next section background may overlap the previous section edge, but must not cover previous section content.",
        "Use z-index/content wrappers to keep content above its own background and above neighbor transition backgrounds.",
        "Do not replace official torn-paper background layers with plain gradient or solid color.",
        "Do not stretch section background images to arbitrary card heights."
      ],
      "layers": [
        {
          "id": "home-hero",
          "assetId": "rocom-hero-bg",
          "sourceSelector": ".part-1",
          "order": 1,
          "coverage": "hero"
        },
        {
          "id": "benefit",
          "assetId": "rocom-part2-bg",
          "sourceSelector": ".part-2::after",
          "order": 2,
          "coverage": "full-width section"
        },
        {
          "id": "calendar",
          "assetId": "rocom-part3-bg",
          "sourceSelector": ".part-3::after",
          "order": 3,
          "coverage": "full-width section"
        },
        {
          "id": "news",
          "assetId": "rocom-part4-bg",
          "sourceSelector": ".part-4::after",
          "order": 4,
          "coverage": "full-width section"
        },
        {
          "id": "media",
          "assetId": "rocom-part5-bg",
          "sourceSelector": ".part-5::after",
          "order": 5,
          "coverage": "full-width section"
        },
        {
          "id": "publish-or-ending",
          "assetId": "rocom-part6-bg",
          "sourceSelector": ".part-6::after",
          "order": 6,
          "coverage": "full-width section"
        }
      ]
    },
    "imageFit": {
      "contentImage": "Use real img element with width:100%; height:auto or aspect-ratio + object-fit:cover only when crop is intended.",
      "heroImage": "Reserve safe area for status/navigation but keep hero media adaptive; do not squash into fixed-height cards."
    },
    "overlay": {
      "inspectorTag": {
        "positioning": "absolute overlay outside layout flow",
        "mustNotAffectLayout": true
      }
    },
    "bottomBarReserve": {
      "required": true,
      "minPadding": "calc(bottomBarHeight + safeArea + 24px)"
    }
  },
  "platformOverrides": {
    "h5": {
      "fontFamilyPropagation": "Apply display font to headings/nav/buttons plus Taro/Web component wrappers when present.",
      "assetLoading": "Prefer vendored assets for production; remote official URLs are demo-only evidence."
    },
    "miniProgram": {
      "safeArea": "Reserve status bar, navigation bar, bottom tabbar, and home indicator.",
      "imageMode": "Use aspectFit/aspectFill by slot role; avoid background-image for content images."
    },
    "qdmp": {
      "consumerRole": "Optional downstream consumer. It reads this MOD as input but does not define the /brand output format.",
      "expectedInput": [
        "tokens",
        "componentVariants",
        "slots",
        "assets",
        "layoutRules",
        "platformOverrides"
      ]
    }
  },
