        "reason": "Tokens and assets must start from computed/rendered evidence before mapping."
      },
      {
        "id": "section-background-chain",
        "status": "required",
        "reason": "RoCom depends on layered section after backgrounds, not isolated card frames."
      },
      {
        "id": "slot-consumption",
        "status": "required",
        "reason": "Assets must be assigned to visual slots before business projects consume the package."
      },
      {
        "id": "operator-readable-boundary",
        "status": "required",
        "reason": "/brand output should state preview/apply boundaries without leaking internal token tables by default."
      }
    ],
    "ruleCandidates": [
      {
        "id": "rendered-asset-inventory-must-include-pseudo-elements",
        "observedIn": "RoCom missed .part-2::after backgrounds and star picture/source assets before rendered inventory was expanded.",
        "abstractMechanism": "Asset crawl must collect DOM img/currentSrc/srcset plus CSS background/mask/border-image on real elements and ::before/::after pseudo-elements.",
        "appliesWhen": "The source site uses CSS url(), picture/source, pseudo-elements, masks, frame images, sprites, or animated decoration assets.",
        "evidenceRequired": [
          "selector or DOM path",
          "computed background/mask/border-image or currentSrc/srcset",
          "resolved asset URL",
          "visual role such as hero, section-background, sprite, frame, icon, or content-media"
        ],
        "scriptCheck": "collect-rendered-assets must warn when asset inventory has hero/content images but no pseudo-element/background asset candidates.",
        "promotion": {
          "level": "candidate-warning",
          "verifiedBrands": [
            "rocom",
            "hpma",
            "re1999"
          ],
          "notes": "The broad asset-inventory mechanism is confirmed by HPMA frame/font assets and RE1999 texture/font/state assets; pseudo-element backgrounds remain a RoCom-specific example, so keep this as warning until the crawler script is stable."
        }
      },
      {
        "id": "section-background-chain-needs-layer-contract",
        "observedIn": "RoCom torn-paper sections rendered as isolated cards, leaked solid colors, or covered previous-section content.",
        "abstractMechanism": "Section background chains need explicit background, transition, and content layers with z-index and overlap policy.",
        "appliesWhen": "The source site visually connects sections through overlapping backgrounds, torn-paper edges, masks, gradients, or decorative separators.",
        "evidenceRequired": [
          "source section selector",
          "computed ::before/::after background or mask",
          "position/z-index relationship",
          "screenshot showing overlap direction"
        ],
        "scriptCheck": "validate-brand-mod warns if sectionBackgroundChain exists without full-width coverage, sourceSelector, and layering rules.",
        "promotion": {
          "level": "candidate-warning",
          "verifiedBrands": [
            "rocom",
            "hpma",
            "re1999"
          ],
          "notes": "Layer contracts generalize across RoCom torn-paper sections, HPMA framed/atmosphere sections, and RE1999 archive texture layers. The exact RoCom torn-paper artwork stays brand-specific."
        }
      },
      {
        "id": "inspector-overlay-must-not-change-layout",
        "observedIn": "RoCom hover tag entered layout flow, shrinking Hero/Image blocks and hiding shadows.",
        "abstractMechanism": "Inspector affordances must be absolute/debug-only overlays and must never affect layout, image fit, shadow, or hover states.",
        "appliesWhen": "Demo pages add hover labels, click targets, blue outlines, tags, or inspection markers over real preview content.",
        "evidenceRequired": [
          "before/after hover bounding boxes",
          "computed transform/width/height/box-shadow diff",
          "overlay selector"
        ],
        "scriptCheck": "asset-usage-gate must flag hover-induced bounding-box or computed-style diffs on inspected content nodes.",
        "promotion": {
          "level": "blocking",
          "verifiedBrands": [
            "rocom",
            "hpma",
            "re1999"
          ],
          "notes": "This is platform-universal for the demo inspector: hover labels, outlines, and markers must not change preview layout or computed style."
        }
      },
