            "nav-font",
            "magic-glow",
            "parchment-text",
            "ornate-frame"
          ],
          "antiPatterns": [
            "generic-rounded-card",
            "download-card-if-not-core",
            "shadow-without-source"
          ]
        },
        {
          "id": "page:hpma-news",
          "scenarioRole": "news-feed",
          "distributionSide": [
            "event",
            "news",
            "notice"
          ],
          "displaySide": [
            "news-carousel",
            "dated-list",
            "gold-tag-tabs"
          ],
