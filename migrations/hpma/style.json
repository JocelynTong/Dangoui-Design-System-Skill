  },
  "document": {
    "id": "style:hpma",
    "name": "HPMA Brand Style",
    "type": "DOCUMENT",
    "children": [
      {
        "id": "page:hpma-home",
        "name": "HPMA / 官网首页",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:hpma:home:hero",
            "name": "Hero / Hogwarts Letter",
            "type": "FRAME",
            "absoluteBoundingBox": {
              "x": 0,
              "y": 0,
              "width": 375,
              "height": 312
            },
            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.page.darkBrown}"
              },
              {
                "type": "GRADIENT_RADIAL",
                "name": "gold magical glow"
              }
            ],
            "strokes": [
              {
                "type": "SOLID",
                "boundVariable": "{color.frame.gold}"
              }
            ],
            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "hero-scene",
                "migrationIntent": "use-dark-scene-plus-gold-frame",
                "targets": {
                  "dangoui": {
                    "component": "Hero"
                  },
                  "vue": {
                    "component": "section"
                  },
                  "unocss": {
                    "shortcut": "hpma-hero-scene"
                  }
                }
              }
            }
          },
          {
            "id": "web:hpma:home:letter-actions",
            "name": "Button Group / 入学行动",
            "type": "INSTANCE",
            "componentProperties": {
              "Tone": {
                "value": "primary-outline",
                "type": "VARIANT"
              }
            },
            "boundVariables": {
              "primaryColor": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.action.brown}"
              },
              "borderColor": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.frame.gold}"
              }
            },
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "control",
                "migrationIntent": "keep-control-radius-separate-from-frame-radius",
                "targets": {
                  "dangoui": {
                    "component": "Button",
                    "props": [
                      "type"
                    ]
                  },
                  "vue": {
                    "component": "DuButton"
                  },
                  "unocss": {
                    "shortcut": "hpma-control-button"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "id": "page:hpma-news",
        "name": "HPMA / 资讯活动",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:hpma:news:carousel",
            "name": "Swiper / 魔法资讯轮播",
            "type": "FRAME",
            "absoluteBoundingBox": {
              "x": 0,
              "y": 0,
              "width": 343,
              "height": 190
            },
            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.surface.panelBrown}"
              },
              {
                "type": "GRADIENT_LINEAR",
                "name": "dark-to-gold scene overlay"
              }
            ],
            "strokes": [],
            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "media-frame",
                "migrationIntent": "ornate-frame-replaces-default-border",
                "targets": {
                  "dangoui": {
                    "component": "Swiper"
                  },
                  "vue": {
                    "component": "DuSwiper"
                  },
                  "unocss": {
                    "shortcut": "hpma-ornate-media-frame"
                  }
                }
              }
            }
          },
          {
            "id": "web:hpma:news:tabs",
            "name": "Tabs / 活动新闻公告",
            "type": "INSTANCE",
            "componentId": "dangoui:Tabs",
            "componentProperties": {
              "type": {
                "value": "tag",
                "type": "VARIANT"
              },
              "state": {
                "value": "selected",
                "type": "VARIANT"
              }
            },
            "boundVariables": {
              "selectedBg": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.action.brown}"
              },
              "selectedText": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.text.parchment}"
              }
            },
            "children": []
          }
        ]
      },
      {
        "id": "page:hpma-cards",
        "name": "HPMA / 魔咒卡牌",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:hpma:cards:spell-media",
