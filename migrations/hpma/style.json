  "brandMetadata": {
    "targets": [
      "dangoui",
      "vue",
      "unocss",
      "assets"
    ],
    "status": "draft",
    "reviewQueue": [
      "Download HPMA border and icon assets locally instead of relying on remote CSS names.",
      "Verify whether ornate media frame is a real double frame or a border replacement before applying inset layers.",
      "Keep frame/card/media radius at 0px; keep control radius separate."
    ],
    "demoWorkflow": {
      "pages": [
        {
          "id": "page:hpma-home",
          "scenarioRole": "home-distribution",
          "distributionSide": [
            "news",
            "features",
            "spell-cards",
            "media"
          ],
          "displaySide": [
            "hogwarts-letter-hero",
            "parchment-copy",
            "entry-actions"
          ],
          "interactiveStates": [
            "button.hover",
            "entry.active"
          ],
          "assetRoles": [
