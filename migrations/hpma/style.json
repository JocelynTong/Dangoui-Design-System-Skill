            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "spell-illustration-shell",
                "migrationIntent": "media-and-card-frame-radius-is-zero",
                "targets": {
                  "dangoui": {
                    "component": "Image"
                  },
                  "vue": {
                    "component": "DuImage"
                  },
                  "unocss": {
                    "shortcut": "hpma-spell-media"
                  }
                }
              }
            }
          }
        ]
      }
