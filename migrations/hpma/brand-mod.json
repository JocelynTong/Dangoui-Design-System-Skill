  },
  "componentVariants": [
    {
      "id": "hpma-ornate-top-nav",
      "base": [
        "NavigationBar",
        "Tabs"
      ],
      "visualRole": "top navigation with center logo and ornate hover decoration",
      "status": "composed",
      "rules": [
        "Keep DangoUI navigation behavior.",
        "Use font/nav/ornate line evidence for visual skin."
      ]
    },
    {
      "id": "hpma-download-panel",
      "base": [
        "Card",
        "Button",
        "Image"
      ],
      "visualRole": "download and QR panel",
      "status": "composed",
      "rules": [
        "Use brown primary controls.",
        "Asset badges are slots, not hard-coded emoji or text decoration."
      ]
    },
    {
      "id": "hpma-news-carousel-with-list",
      "base": [
        "Swiper",
        "Tabs",
        "Card",
        "Tag"
      ],
      "visualRole": "news banner plus list",
      "status": "composed",
      "rules": [
        "Tabs inherit antique gold selected state.",
        "List separators use --style-divider-color."
      ]
    },
    {
      "id": "hpma-media-thumbnail-grid",
      "base": [
        "Image",
        "Card"
      ],
      "visualRole": "media grid with ornate frame",
      "status": "style-only",
      "rules": [
        "Decorative frame replaces normal card border.",
        "Apply only to media thumbnails or target frames."
      ]
    },
    {
      "id": "hpma-spell-character-card",
      "base": [
        "Card",
        "Image",
        "Badge"
      ],
      "visualRole": "spell or character card",
      "status": "fallback",
      "rules": [
        "Rarity frames and card shells remain asset/component gaps."
      ]
    }
  ],
  "slots": [
    {
      "id": "hero-media",
      "component": "HeroHeader",
      "accepts": [
        "hero-background",
        "scene-image"
      ],
      "required": true,
      "rules": [
        "Use real media when available.",
        "Do not replace source media with abstract gradient when an asset exists."
      ]
    },
    {
      "id": "ornate-frame",
      "component": "Card/Image",
      "accepts": [
        "frame-asset",
        "corner-line-css"
      ],
      "required": true,
      "rules": [
        "Frame is selective.",
        "Do not put ornate borders on every card."
      ]
    },
    {
      "id": "display-font",
      "component": "Typography",
      "accepts": [
        "font"
      ],
      "required": false,
      "rules": [
        "Vendored font preferred.",
        "Remote-only font must fall back without blocking preview."
      ]
    },
    {
      "id": "brand-icon-system",
      "component": "IconButton/Button",
      "accepts": [
        "image-icon",
        "DangoUI icon fallback"
      ],
      "required": false,
      "rules": [
        "Use official image assets if extracted.",
        "Do not invent decorative emoji substitutes."
      ]
    }
  ],
  "assets": [
    {
      "id": "hpma-page-atmosphere",
      "role": "section-background",
      "source": "migrations/hpma/dangoui-adapter.json#demoOnlyVisualControls.--style-media",
      "usage": "Brown, gold and blue magical page atmosphere for section surfaces.",
      "fit": "cover; fallback only until official page assets are available",
      "status": "style-only"
    },
    {
      "id": "hpma-hero-media",
      "role": "hero-background",
      "source": "migrations/hpma/brand-evidence.json#mediaColor",
      "usage": "Feature split scene or hero media slot.",
      "fit": "preserve image ratio; cover only for true hero surfaces",
      "status": "candidate"
    },
    {
      "id": "hpma-ornate-frame",
      "role": "frame-asset",
      "source": "media_border_67b7223.png / media_border2_e5450c6.png evidence",
      "usage": "Media frame or thumbnail shell.",
      "fit": "border-image or corner-line fallback",
      "status": "missing-local-asset"
    },
    {
      "id": "hpma-display-font",
      "role": "font",
      "source": "uifont_cn_title / navfont evidence",
      "usage": "Display title and navigation type.",
      "fit": "font-face with system fallback",
      "status": "remote-or-missing"
    }
  ],
  "layoutRules": {
    "sectionBackgroundChain": {
      "mode": "frame-led-page-sections",
      "layers": [
        {
          "id": "hpma-page-shell",
          "assetId": "hpma-page-atmosphere",
          "zIndex": 0,
          "placement": "page or section background",
          "rule": "Use atmosphere behind content; never let inspector hover overlays change layout."
        },
        {
          "id": "hpma-hero-layer",
          "assetId": "hpma-hero-media",
          "zIndex": 1,
          "placement": "hero/media slot",
          "rule": "Media image remains content-bearing and keeps source ratio."
        }
      ]
    },
    "imageFit": {
      "default": "preserve-source-ratio",
      "hero": "cover only when the source is a true full-bleed hero",
      "thumbnail": "object-fit: cover; stable aspect-ratio",
      "forbidden": [
        "stretching raster assets",
        "using background gradients when source media exists"
      ]
    },
    "overlay": {
      "inspectorTag": {
        "mustNotAffectLayout": true,
        "position": "absolute",
        "rule": "Hover labels and selected outlines are tooling chrome, not part of component layout."
      }
    },
    "bottomBarReserve": {
      "required": true,
      "minPadding": "calc(bottom-bar-height + safe-area + 24px)",
      "rule": "Scrollable previews must expose the final feed/card above the TabBar."
    }
  },
  "platformOverrides": {
    "h5": {
      "cssImport": "Prefer JS entry import for theme CSS when Vite/Taro import ordering is fragile.",
      "font": "Remote-only fonts use system fallback and do not block preview."
    },
    "miniProgram": {
      "asset": "Use vendored assets or CDN URLs supported by the target mini-program runtime.",
      "layout": "Keep DangoUI component behavior and change visual shell only."
    }
  },
  "verification": {
    "requiredGates": [
      "schema-valid",
      "computed-style-diff",
      "selector-hit-check",
      "asset-load-check",
      "bottom-bar-scroll-check"
    ],
    "previewLevel": "standard-demo-style-pack",
    "notes": "HPMA requires selective ornate frames; applying them everywhere is a failure."
  },
  "semanticRoles": {
    "surface.page": {
      "kind": "mappedToken",
      "value": "#221b15",
      "target": "--du-bg-2",
      "dtcgPath": "mapped.du-bg-2",
      "status": "mapped",
      "usage": "App/page base surface.",
      "sources": [
        "tokens.mapped.--du-bg-2"
      ],
      "evidence": [
        "warm dark page canvas"
      ]
    },
    "surface.card": {
      "kind": "mappedToken",
      "value": "#493832",
      "target": "--du-bg-1",
      "dtcgPath": "mapped.du-bg-1",
      "status": "mapped",
      "usage": "Readable content card surface.",
      "sources": [
        "tokens.mapped.--du-bg-1"
      ],
      "evidence": [
        "panel/input surface"
      ]
    },
    "text.primary": {
      "kind": "mappedToken",
      "value": "#f4eedc",
      "target": "--du-text-1",
      "dtcgPath": "mapped.du-text-1",
      "status": "mapped",
      "usage": "Primary readable text.",
      "sources": [
        "tokens.mapped.--du-text-1"
      ],
      "evidence": [
        "warm parchment foreground"
      ]
    },
    "text.secondary": {
      "kind": "mappedToken",
      "value": "#e9d9c5",
      "target": "--du-text-2",
      "dtcgPath": "mapped.du-text-2",
      "status": "mapped",
      "usage": "Secondary supporting copy.",
      "sources": [
        "tokens.mapped.--du-text-2"
      ],
      "evidence": [
        "parchment copy"
      ]
    },
    "text.tertiary": {
      "kind": "mappedToken",
      "value": "#c8b08b",
      "target": "--du-text-3",
      "dtcgPath": "mapped.du-text-3",
      "status": "mapped",
      "usage": "Weak labels and tertiary metadata.",
      "sources": [
        "tokens.mapped.--du-text-3"
      ],
      "evidence": [
        "gold-muted label"
      ]
    },
    "border.subtle": {
      "kind": "mappedToken",
      "value": "#8e6140",
      "target": "--du-border-1",
      "dtcgPath": "mapped.du-border-1",
      "status": "mapped",
      "usage": "Default divider and subtle frame.",
      "sources": [
        "tokens.mapped.--du-border-1"
      ],
      "evidence": [
        "antique brown frame"
      ]
    },
    "typography.display.family": {
      "kind": "styleOnlyToken",
      "value": "uifont_cn_title",
      "target": "--style-font-display",
      "dtcgPath": "styleOnly.style-font-display",
      "status": "mapped",
      "usage": "Display or heading font family.",
      "sources": [
        "tokens.styleOnly.--style-font-display"
      ],
      "evidence": [
        "Official title font package, not a DangoUI semantic token."
      ]
    },
    "shape.card.radius": {
      "kind": "styleOnlyToken",
      "value": "0px",
      "target": "--style-card-radius",
      "dtcgPath": "styleOnly.style-card-radius",
      "status": "mapped",
      "usage": "Primary content-card radius.",
      "sources": [
        "tokens.styleOnly.--style-card-radius"
      ],
      "evidence": [
        "Ornate frames are straight-edged; do not infer rounded cards from control evidence."
      ]
    },
    "shape.control.radius": {
      "kind": "styleOnlyToken",
      "value": "5px",
      "target": "--style-control-radius",
      "dtcgPath": "styleOnly.style-control-radius",
      "status": "mapped",
      "usage": "Action/control radius.",
      "sources": [
        "tokens.styleOnly.--style-control-radius"
      ],
      "evidence": [
        "Inputs and small controls have their own radius."
      ]
    },
    "elevation.card.shadow": {
      "kind": "styleOnlyToken",
      "value": "0 20px 48px rgba(0,0,0,.42)",
      "target": "--style-card-shadow",
      "dtcgPath": "styleOnly.style-card-shadow",
      "status": "mapped",
      "usage": "Card or lifted-surface shadow treatment.",
      "sources": [
        "tokens.styleOnly.--style-card-shadow"
      ],
      "evidence": [
        "Magical glow belongs to styled frames and media surfaces, not every card."
      ]
    },
    "action.primary.fill": {
      "kind": "mappedTokenFallback",
      "value": "#996540",
      "target": "--du-primary-color",
      "dtcgPath": "mapped.du-primary-color",
      "status": "mapped",
      "usage": "Fallback primary action fill when no action-evidence sample exists yet; replace with actionEvidence once computed CTA sampling is available.",
      "sources": [
        "tokens.mapped.--du-primary-color"
      ],
      "evidence": [
        "brown action control"
      ],
      "protocol": {
        "source": "fallback-from-mapped-primary",
        "reason": "action-evidence-missing"
      }
    },
    "action.primary.token": {
      "kind": "mappedToken",
      "value": "#996540",
      "target": "--du-primary-color",
      "dtcgPath": "mapped.du-primary-color",
      "status": "mapped",
      "usage": "Current demo-consumed CTA token; compare this with action.primary.fill to detect drift.",
      "sources": [
        "tokens.mapped.--du-primary-color"
      ],
      "evidence": [
        "brown action control"
      ]
    }
  }
}
