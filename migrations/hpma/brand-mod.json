{
  "schema": "brand-mod.v0.1",
  "manifest": {
    "brand": "hpma",
    "displayName": "HPMA",
    "sourceUrl": "https://www.harrypottermagicawakened.com/cn/index.html",
    "createdAt": "2026-08-07",
    "version": "0.1.0",
    "scope": {
      "for": [
        "brand visual migration",
        "mini-program visual skinning",
        "demo capability preview"
      ],
      "notFor": [
        "game-only content mod",
        "business logic rewrite",
        "new route generation by brand key"
      ]
    },
    "producer": {
      "skill": "/brand",
      "decoupledFrom": [
        "/qdmp"
      ],
      "notes": "This MOD is a reusable brand visual package. /qdmp may consume it later, but it is not required to produce it."
    }
  },
  "tokens": {
    "mapped": {
      "--du-bg-2": {
        "value": "#221b15",
        "source": "warm dark page canvas"
      },
      "--du-bg-1": {
        "value": "#493832",
        "source": "panel/input surface"
      },
      "--du-text-1": {
        "value": "#f4eedc",
        "source": "warm parchment foreground"
      },
      "--du-text-2": {
        "value": "#e9d9c5",
        "source": "parchment copy"
      },
      "--du-text-3": {
        "value": "#c8b08b",
        "source": "gold-muted label"
      },
      "--du-border-1": {
        "value": "#8e6140",
        "source": "antique brown frame"
      },
      "--du-primary-color": {
        "value": "#996540",
        "source": "brown action control"
      },
      "--du-primary-outline-color": {
        "value": "#c8b08b",
        "source": "gold outline text"
      }
    },
    "styleOnly": {
      "--style-card-radius": {
        "value": "0px",
        "reason": "Ornate frames are straight-edged; do not infer rounded cards from control evidence."
      },
      "--style-control-radius": {
        "value": "5px",
        "reason": "Inputs and small controls have their own radius."
      },
      "--style-card-shadow": {
        "value": "0 20px 48px rgba(0,0,0,.42)",
        "reason": "Magical glow belongs to styled frames and media surfaces, not every card."
      },
      "--style-divider-color": {
        "value": "rgba(200,176,139,.72)",
        "reason": "Gold hairlines and frame dividers are style-only."
      },
      "--style-frame-corner-size": {
        "value": "22px",
        "reason": "Corner-line fallback for missing ornate media frame assets."
      },
      "--style-font-display": {
        "value": "uifont_cn_title",
        "reason": "Official title font package, not a DangoUI semantic token."
      },
      "--style-font-nav": {
        "value": "navfont",
        "reason": "Official navigation font package."
      }
    },
    "evidence": {
      "sourceFiles": [
        "migrations/hpma/brand-evidence.json",
        "migrations/hpma/dangoui-adapter.json",
        "migrations/hpma/component-mapping.json"
      ],
      "method": "computed-first evidence and existing adapter reconciliation"
    },
    "dtcg": {
      "$description": "HPMA DTCG token contract generated from Brand MOD token mirrors.",
      "$extensions": {
        "echo.brand.schema": "brand-mod.tokens.dtcg/v0.1",
        "echo.brand.sourceFile": "migrations/hpma/brand-mod.json",
        "echo.brand.note": "DTCG is canonical for reusable token values; mapped/styleOnly are compatibility mirrors for current demo consumers."
      },
      "mapped": {
        "du-bg-2": {
          "$type": "color",
          "$value": "#221b15",
          "$description": "warm dark page canvas",
          "$extensions": {
            "echo.brand.target": "--du-bg-2",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-bg-2",
            "echo.brand.source": "warm dark page canvas"
          }
        },
        "du-bg-1": {
          "$type": "color",
          "$value": "#493832",
          "$description": "panel/input surface",
          "$extensions": {
            "echo.brand.target": "--du-bg-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-bg-1",
            "echo.brand.source": "panel/input surface"
          }
        },
        "du-text-1": {
          "$type": "color",
          "$value": "#f4eedc",
          "$description": "warm parchment foreground",
          "$extensions": {
            "echo.brand.target": "--du-text-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-1",
            "echo.brand.source": "warm parchment foreground"
          }
        },
        "du-text-2": {
          "$type": "color",
          "$value": "#e9d9c5",
          "$description": "parchment copy",
          "$extensions": {
            "echo.brand.target": "--du-text-2",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-2",
            "echo.brand.source": "parchment copy"
          }
        },
        "du-text-3": {
          "$type": "color",
          "$value": "#c8b08b",
          "$description": "gold-muted label",
          "$extensions": {
            "echo.brand.target": "--du-text-3",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-3",
            "echo.brand.source": "gold-muted label"
          }
        },
        "du-border-1": {
          "$type": "color",
          "$value": "#8e6140",
          "$description": "antique brown frame",
          "$extensions": {
            "echo.brand.target": "--du-border-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-border-1",
            "echo.brand.source": "antique brown frame"
          }
        },
        "du-primary-color": {
          "$type": "color",
          "$value": "#996540",
          "$description": "brown action control",
          "$extensions": {
            "echo.brand.target": "--du-primary-color",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-primary-color",
            "echo.brand.source": "brown action control"
          }
        },
        "du-primary-outline-color": {
          "$type": "color",
          "$value": "#c8b08b",
          "$description": "gold outline text",
          "$extensions": {
            "echo.brand.target": "--du-primary-outline-color",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-primary-outline-color",
            "echo.brand.source": "gold outline text"
          }
        }
      },
      "styleOnly": {
        "style-card-radius": {
          "$type": "dimension",
          "$value": "0px",
          "$description": "Ornate frames are straight-edged; do not infer rounded cards from control evidence.",
          "$extensions": {
