          "$extensions": {
            "echo.brand.target": "--style-control-radius",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-control-radius",
            "echo.brand.reason": "Inputs and small controls have their own radius."
          }
        },
        "style-card-shadow": {
          "$type": "shadow",
          "$value": "0 20px 48px rgba(0,0,0,.42)",
          "$description": "Magical glow belongs to styled frames and media surfaces, not every card.",
          "$extensions": {
            "echo.brand.target": "--style-card-shadow",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-card-shadow",
            "echo.brand.reason": "Magical glow belongs to styled frames and media surfaces, not every card."
          }
        },
        "style-divider-color": {
          "$type": "color",
          "$value": "rgba(200,176,139,.72)",
          "$description": "Gold hairlines and frame dividers are style-only.",
          "$extensions": {
            "echo.brand.target": "--style-divider-color",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-divider-color",
            "echo.brand.reason": "Gold hairlines and frame dividers are style-only."
          }
        },
        "style-frame-corner-size": {
          "$type": "dimension",
          "$value": "22px",
          "$description": "Corner-line fallback for missing ornate media frame assets.",
          "$extensions": {
            "echo.brand.target": "--style-frame-corner-size",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-frame-corner-size",
            "echo.brand.reason": "Corner-line fallback for missing ornate media frame assets."
          }
        },
        "style-font-display": {
          "$type": "fontFamily",
          "$value": "uifont_cn_title",
          "$description": "Official title font package, not a DangoUI semantic token.",
          "$extensions": {
            "echo.brand.target": "--style-font-display",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
