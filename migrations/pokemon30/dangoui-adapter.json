{
  "brand": "pokemon30",
  "displayName": "Pokemon 30th",
  "tokens": {
    "--du-bg-2": {
      "value": "#fee12a",
      "status": "mapped",
      "source": "official anniversary page canvas background-color rgb(254,225,42)"
    },
    "--du-bg-1": {
      "value": "#ffffff",
      "status": "mapped",
      "source": "white list/card surfaces on official 30th page"
    },
    "--du-text-1": {
      "value": "#404248",
      "status": "mapped",
      "source": "official body/list primary text"
    },
    "--du-text-2": {
      "value": "#6b7280",
      "status": "inferred",
      "source": "secondary readable copy between body text and disabled gray"
    },
    "--du-text-3": {
      "value": "#b3bac7",
      "status": "mapped",
      "source": "weak labels / disabled metadata gray scale"
    },
    "--du-border-1": {
      "value": "#dde1ea",
      "status": "mapped",
      "source": "light divider / card boundary family"
    },
    "--du-primary-color": {
      "value": "#e5161a",
      "status": "protocol-derived",
      "source": "action evidence activeStateFill primary red"
    },
    "--du-primary-border": {
      "value": "#404248",
      "status": "protocol-derived",
      "source": "action evidence readable dark text/border family"
    },
    "--du-primary-soft-bg": {
      "value": "#fffb8a",
      "status": "protocol-derived",
      "source": "soft action fill from computed action evidence"
    },
    "--du-primary-solid-bg": {
      "value": "#e5161a",
      "status": "protocol-derived",
      "source": "solid CTA red"
    },
    "--du-secondary-color": {
      "value": "#ffcb05",
      "status": "mapped",
      "source": "anniversary yellow accent / logo emphasis"
    }
  },
  "demoOnlyVisualControls": {
    "--style-font-body": {
      "value": "'Noto Sans JP', Helvetica, Arial, sans-serif",
      "status": "style-only",
      "reason": "Official body typography uses Noto Sans JP."
    },
    "--style-font-display": {
      "value": "'Lato', 'Noto Sans JP', sans-serif",
      "status": "style-only",
      "reason": "Official display/Latin headings use Lato with Noto Sans JP fallback."
    },
    "--style-card-radius": {
      "value": "10px",
      "status": "style-only",
      "reason": "Official list cards and media thumbnails use 10px rounded corners."
    },
    "--style-control-radius": {
      "value": "999px",
      "status": "style-only",
      "reason": "Theme filters and small controls are pill-shaped."
    },
    "--style-card-shadow": {
      "value": "0 0 15px rgba(0,0,0,.15)",
      "status": "style-only",
      "reason": "Cards float lightly; do not upgrade this into a heavy FAB/material shadow."
    },
    "--style-hero-ratio-pc": {
      "value": "1920 / 735",
      "status": "style-only",
      "reason": "Desktop hero must preserve official picture ratio."
    },
    "--style-hero-ratio-sp": {
      "value": "750 / 642",
      "status": "style-only",
      "reason": "Mobile hero must preserve official picture ratio."
    },
    "--style-category-palette": {
      "value": {
        "shop": "#00c879",
        "game": "#ff3441",
        "app": "#c620d3",
        "card": "#5969df",
        "tvMovie": "#1fcade",
        "goods": "#ff9f3d",
        "event": "#93695a",
        "campaign": "#ff00bc",
        "important": "#d00"
      },
      "status": "style-only",
      "reason": "Category colors are semantic taxonomy colors and must not collapse into one primary."
    },
    "heroPictureRule": {
      "status": "style-only",
      "reason": "Hero uses official picture assets with preserved ratio, not a generic colored card."
    },
    "imageFitRule": {
      "status": "style-only",
      "reason": "News/campaign images must stay in Image/currentSrc/object-fit contain flow, not be rewritten as decorative backgrounds."
    }
  },
  "components": {
    "pokemon30-official-navigation": {
      "status": "composed",
      "dangouiComponents": [
        "NavigationBar"
      ],
      "uses": [
        "official logo slot",
        "category navigation",
        "light shell"
      ],
      "unsupported": [
        "full official mega navigation behavior"
      ]
    },
    "pokemon30-anniversary-hero": {
      "status": "composed",
      "dangouiComponents": [
        "HeroHeader",
        "Image",
        "Tag",
        "Button"
      ],
      "uses": [
        "picture hero background",
        "hero logo",
        "theme badge",
        "summary CTA"
      ],
      "unsupported": [
        "exact official responsive art direction until screenshot/computed gate is added"
      ]
    },
    "pokemon30-theme-filter": {
      "status": "composed",
      "dangouiComponents": [
        "Tabs",
        "SegmentControl"
      ],
      "uses": [
        "monthly theme category pills",
        "disabled future states",
        "semantic category filters",
        "Pikachu tab accent"
      ],
      "unsupported": [
        "exact official tab animation timing until computed/browser trace is added"
      ]
    },
    "pokemon30-news-grid-card": {
      "status": "composed",
      "dangouiComponents": [
        "Card",
        "Image",
        "Tag"
      ],
      "uses": [
        "image slot",
        "date text",
        "category tag",
        "white rounded surface",
        "light shadow"
      ],
      "unsupported": [
        "live news feed"
      ]
    },
    "pokemon30-logo-banner": {
      "status": "asset-slot",
      "dangouiComponents": [
        "Image"
      ],
      "uses": [
        "anniversary logo banner",
        "external campaign link"
      ],
      "unsupported": [
        "interactive claim/download flow"
      ]
    }
  },
  "slots": {
    "hero-background": {
      "role": "hero media",
      "target": "HeroHeader.picture",
      "required": true,
      "fallback": "Use neutral light surface only if official hero asset fails to load; do not replace with abstract gradient."
    },
    "hero-logo": {
      "role": "brand logo",
      "target": "HeroHeader.logo",
      "required": true,
      "fallback": "Text brand label with Lato/Noto Sans JP."
    },
    "theme-badge": {
      "role": "monthly theme marker",
      "target": "HeroHeader.badge or Tag",
      "required": true,
      "fallback": "Pill tag with theme text."
    },
    "category-filter": {
      "role": "filter control",
      "target": "Tabs or SegmentControl",
      "required": true,
      "fallback": "Scrollable pill list."
    },
    "news-card-image": {
      "role": "content image",
      "target": "Card.Image",
      "required": true,
      "fallback": "Visible missing-asset state only."
    },
    "logo-banner": {
      "role": "campaign banner",
      "target": "Image",
      "required": false,
      "fallback": "White card with anniversary logo text."
    }
  },
  "assets": {
    "pokemon30-hero-bg-pc": {
      "role": "hero-background",
      "source": "https://www.pokemon.co.jp/img/30th/hero-bg-1_pc.png",
      "fit": "preserve 1920x735 ratio; use picture art direction"
    },
    "pokemon30-hero-bg-sp": {
      "role": "hero-background",
      "source": "https://www.pokemon.co.jp/img/30th/hero-bg-1_sp.png",
      "fit": "preserve 750x642 ratio"
    },
    "pokemon30-hero-logo": {
      "role": "logo",
      "source": "https://www.pokemon.co.jp/img/30th/hero-logo-default.png",
      "fit": "intrinsic ratio; do not stretch"
    },
    "pokemon30-theme-kakeru": {
      "role": "badge-asset",
      "source": "https://www.pokemon.co.jp/img/30th/theme-kakeru.svg",
      "fit": "intrinsic SVG ratio"
    },
    "pokemon30-tab-pikachu": {
      "role": "section-accent",
      "source": "https://www.pokemon.co.jp/img/30th/tab-pikachu.svg",
      "fit": "intrinsic decoration; do not tile as page background"
    },
    "pokemon30-logo-banner": {
      "role": "banner",
      "source": "https://www.pokemon.co.jp/img/30th/bnr-logo.jpg",
      "fit": "preserve banner ratio"
    }
  }
}
