{
  "name": "pokemon30",
  "displayName": "Pokemon 30th",
  "schemaVersion": 1,
  "source": {
    "type": "web",
    "url": "https://www.pokemon.co.jp/30th/",
    "evidence": [
      "migrations/pokemon30/brand-evidence.json",
      "migrations/pokemon30/asset-inventory.json",
      "migrations/pokemon30/brand-mod.json"
    ]
  },
  "goldenTemplate": {
    "id": "anniversary-campaign-official-site",
    "status": "evidence-draft",
    "templateFamily": "anniversary / campaign official site",
    "recommendedPages": ["30th Home", "News Feed", "Campaign Banner"],
    "styleReference": false
  },
  "document": {
    "id": "style:pokemon30",
    "name": "Pokemon 30th Style Draft",
    "type": "DOCUMENT",
    "children": [
      {
        "id": "page:pokemon30-home",
        "name": "Pokemon 30th / Home",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:pokemon30:home:hero",
            "name": "HeroHeader / 30th Anniversary Hero",
            "type": "FRAME",
            "absoluteBoundingBox": { "x": 0, "y": 0, "width": 375, "height": 321 },
            "fills": [
              { "type": "SOLID", "boundVariable": "{color.page.lightNeutral}" },
              { "type": "IMAGE", "name": "hero-bg-1_sp.png" }
            ],
            "cornerRadius": 0,
            "pluginData": {
              "echo.brand": {
                "assetRole": "anniversary-hero",
                "migrationIntent": "responsive picture hero with official 30th logo and theme badge",
                "targets": {
                  "dangoui": { "component": "HeroHeader" },
                  "vue": { "class": "pokemon30-hero" }
                }
              }
            }
          },
          {
            "id": "web:pokemon30:home:theme-filter",
            "name": "Tabs / Monthly Theme Filter",
            "type": "FRAME",
            "absoluteBoundingBox": { "x": 16, "y": 337, "width": 343, "height": 58 },
            "fills": [{ "type": "SOLID", "boundVariable": "{color.surface.white}" }],
            "cornerRadius": 999,
            "pluginData": {
              "echo.brand": {
                "assetRole": "theme-filter",
                "migrationIntent": "scrollable monthly theme pills with disabled future states",
                "targets": {
                  "dangoui": { "component": "Tabs" },
                  "vue": { "class": "pokemon30-theme-filter" }
                }
              }
            }
          },
          {
            "id": "web:pokemon30:home:news-grid",
            "name": "Card Grid / News Cards",
            "type": "FRAME",
            "absoluteBoundingBox": { "x": 16, "y": 411, "width": 343, "height": 420 },
            "fills": [{ "type": "SOLID", "boundVariable": "{color.surface.white}" }],
            "cornerRadius": 10,
            "pluginData": {
              "echo.brand": {
                "assetRole": "news-grid",
                "migrationIntent": "white rounded card feed with contain images and semantic category tags",
                "targets": {
                  "dangoui": { "component": "Card/Image/Tag" },
                  "vue": { "class": "pokemon30-news-grid" }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "tokens": {
    "color": {
      "page.lightNeutral": "#f5f5f6",
      "surface.white": "#ffffff",
      "text.primary": "#404248",
      "line.light": "#dde1ea",
      "action.blue": "#489fe6"
    },
    "radius": {
      "card": "10px",
      "control": "999px"
    },
    "shadow": {
      "card": "0 0 15px rgba(0,0,0,.15)"
    }
  },
  "assets": [
    "pokemon30-hero-bg-pc",
    "pokemon30-hero-bg-sp",
    "pokemon30-hero-logo",
    "pokemon30-theme-kakeru",
    "pokemon30-logo-banner",
    "pokemon30-tab-pikachu"
  ],
  "qualityGate": {
    "status": "draft",
    "mustPass": [
      "hero ratio is preserved",
      "news images use contain",
      "category colors remain semantic",
      "hover inspector does not affect layout"
    ]
  }
}
