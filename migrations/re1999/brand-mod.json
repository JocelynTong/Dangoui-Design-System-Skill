{
  "schema": "brand-mod.v0.1",
  "manifest": {
    "brand": "re1999",
    "displayName": "1999",
    "sourceUrl": "https://re.bluepoch.com/home/",
    "createdAt": "2026-08-07",
    "version": "0.1.0",
    "scope": {
      "for": [
        "brand visual migration",
        "mini-program visual skinning",
        "demo capability preview"
      ],
      "notFor": [
        "game-only content mod",
        "business logic rewrite",
        "new route generation by brand key"
      ]
    },
    "producer": {
      "skill": "/brand",
      "decoupledFrom": [
        "/qdmp"
      ],
      "notes": "This MOD captures a reusable archival visual language; it is not tied to one game category or to /qdmp initialization."
    }
  },
  "tokens": {
    "mapped": {
      "--du-bg-2": {
        "value": "#000000",
        "source": "dark site canvas"
      },
      "--du-bg-1": {
        "value": "#131818",
        "source": "archive panel surface"
      },
      "--du-text-1": {
        "value": "#E9DCCD",
        "source": "warm paper foreground"
      },
      "--du-text-2": {
        "value": "#BBA893",
        "source": "muted archive copy"
      },
      "--du-text-3": {
        "value": "#BBA893",
        "source": "muted archive copy"
      },
      "--du-border-1": {
        "value": "#45392F",
        "source": "plain divider and panel line"
      },
      "--du-primary-color": {
        "value": "#B55829",
        "source": "copper emphasis"
      },
      "--du-primary-outline-color": {
        "value": "#db6f39",
        "source": "active/selection copper"
      }
    },
    "styleOnly": {
      "--style-card-radius": {
        "value": "0px",
        "reason": "Archival frame geometry is straight-edged."
      },
      "--style-large-media-radius": {
        "value": "0 56px 0 0",
        "reason": "Only large media shells use the top-right radius."
      },
      "--style-control-radius": {
        "value": "42px",
        "reason": "Pill controls are separate from card and media frame geometry."
      },
      "--style-card-shadow": {
        "value": "none",
        "reason": "Evidence says do not add generic shadow; use copper border or asset frame instead."
      },
      "--style-frame-border": {
        "value": "1px solid #45392F",
        "reason": "Archive panels use real borders rather than soft elevation."
      }
    },
    "evidence": {
      "sourceFiles": [
        "migrations/re1999/brand-evidence.json",
        "migrations/re1999/dangoui-adapter.json"
      ],
      "method": "computed-first evidence and adapter conflict resolution"
    },
    "dtcg": {
      "$description": "1999 DTCG token contract generated from Brand MOD token mirrors.",
      "$extensions": {
        "echo.brand.schema": "brand-mod.tokens.dtcg/v0.1",
        "echo.brand.sourceFile": "migrations/re1999/brand-mod.json",
        "echo.brand.note": "DTCG is canonical for reusable token values; mapped/styleOnly are compatibility mirrors for current demo consumers."
      },
      "mapped": {
        "du-bg-2": {
          "$type": "color",
          "$value": "#000000",
          "$description": "dark site canvas",
          "$extensions": {
            "echo.brand.target": "--du-bg-2",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-bg-2",
            "echo.brand.source": "dark site canvas"
          }
        },
        "du-bg-1": {
          "$type": "color",
          "$value": "#131818",
          "$description": "archive panel surface",
          "$extensions": {
            "echo.brand.target": "--du-bg-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-bg-1",
            "echo.brand.source": "archive panel surface"
          }
        },
        "du-text-1": {
          "$type": "color",
          "$value": "#E9DCCD",
          "$description": "warm paper foreground",
          "$extensions": {
            "echo.brand.target": "--du-text-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-1",
            "echo.brand.source": "warm paper foreground"
          }
        },
        "du-text-2": {
          "$type": "color",
          "$value": "#BBA893",
          "$description": "muted archive copy",
          "$extensions": {
            "echo.brand.target": "--du-text-2",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-2",
            "echo.brand.source": "muted archive copy"
          }
        },
        "du-text-3": {
          "$type": "color",
          "$value": "#BBA893",
          "$description": "muted archive copy",
          "$extensions": {
            "echo.brand.target": "--du-text-3",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-text-3",
            "echo.brand.source": "muted archive copy"
          }
        },
        "du-border-1": {
          "$type": "color",
          "$value": "#45392F",
          "$description": "plain divider and panel line",
          "$extensions": {
            "echo.brand.target": "--du-border-1",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-border-1",
            "echo.brand.source": "plain divider and panel line"
          }
        },
        "du-primary-color": {
          "$type": "color",
          "$value": "#B55829",
          "$description": "copper emphasis",
          "$extensions": {
            "echo.brand.target": "--du-primary-color",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-primary-color",
            "echo.brand.source": "copper emphasis"
          }
        },
        "du-primary-outline-color": {
          "$type": "color",
          "$value": "#db6f39",
          "$description": "active/selection copper",
          "$extensions": {
            "echo.brand.target": "--du-primary-outline-color",
            "echo.brand.channel": "mapped",
            "echo.brand.status": "mapped",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--du-primary-outline-color",
            "echo.brand.source": "active/selection copper"
          }
        }
      },
      "styleOnly": {
        "style-card-radius": {
          "$type": "dimension",
          "$value": "0px",
          "$description": "Archival frame geometry is straight-edged.",
          "$extensions": {
            "echo.brand.target": "--style-card-radius",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-card-radius",
            "echo.brand.reason": "Archival frame geometry is straight-edged."
          }
        },
        "style-large-media-radius": {
          "$type": "string",
          "$value": "0 56px 0 0",
          "$description": "Only large media shells use the top-right radius.",
          "$extensions": {
            "echo.brand.target": "--style-large-media-radius",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-large-media-radius",
            "echo.brand.reason": "Only large media shells use the top-right radius."
          }
        },
        "style-control-radius": {
          "$type": "dimension",
          "$value": "42px",
          "$description": "Pill controls are separate from card and media frame geometry.",
          "$extensions": {
            "echo.brand.target": "--style-control-radius",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-control-radius",
            "echo.brand.reason": "Pill controls are separate from card and media frame geometry."
          }
        },
        "style-card-shadow": {
          "$type": "shadow",
          "$value": "none",
          "$description": "Evidence says do not add generic shadow; use copper border or asset frame instead.",
          "$extensions": {
            "echo.brand.target": "--style-card-shadow",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-card-shadow",
            "echo.brand.reason": "Evidence says do not add generic shadow; use copper border or asset frame instead."
          }
        },
        "style-frame-border": {
          "$type": "string",
          "$value": "1px solid #45392F",
          "$description": "Archive panels use real borders rather than soft elevation.",
          "$extensions": {
            "echo.brand.target": "--style-frame-border",
            "echo.brand.channel": "styleOnly",
            "echo.brand.status": "styleOnly",
            "echo.brand.usage": "",
            "echo.brand.legacyKey": "--style-frame-border",
            "echo.brand.reason": "Archive panels use real borders rather than soft elevation."
          }
        }
      }
    }
  },
  "componentVariants": [
    {
      "id": "re1999-navigation-logo",
      "base": [
        "NavigationBar",
        "Image"
      ],
      "visualRole": "navigation with low-opacity brand watermark",
      "status": "composed",
      "rules": [
        "Use logo as asset layer.",
        "Do not rely on tiny nav text as the only brand signal."
      ]
    },
    {
      "id": "re1999-archive-card-frame",
      "base": [
        "Card"
      ],
      "visualRole": "flat archive panel with copper frame",
      "status": "style-only",
      "rules": [
        "No generic shadow.",
        "Use straight corners and copper border."
      ]
    },
    {
      "id": "re1999-large-media-shell",
      "base": [
        "Image",
        "Swiper"
      ],
      "visualRole": "large media shell with asymmetric top-right radius",
      "status": "style-only",
      "rules": [
        "Large media radius must not leak to ordinary cards.",
        "Image assets keep source ratio."
      ]
    },
    {
      "id": "re1999-role-media",
      "base": [
        "Image",
        "Card"
      ],
      "visualRole": "role media stage with character art and decorative layers",
      "status": "composed",
      "rules": [
        "Character art is a slot.",
        "Role background and orbital decor are separate asset layers."
      ]
    },
    {
      "id": "re1999-selected-state",
      "base": [
        "Tabs",
        "SegmentControl",
        "Button"
      ],
      "visualRole": "active state with copper line or image pair",
      "status": "style-only",
      "rules": [
        "If selected image pair exists, use it.",
        "Do not replace selected state with heavy shadow."
      ]
    }
  ],
  "slots": [
    {
      "id": "page-texture",
      "component": "Page",
      "accepts": [
        "section-background",
        "texture"
      ],
      "required": true,
      "rules": [
        "Use BG2 or page-specific background candidate.",
        "Do not flatten to plain dark color when texture exists."
      ]
    },
    {
      "id": "logo-watermark",
      "component": "NavigationBar",
      "accepts": [
        "brand-mark"
      ],
      "required": false,
      "rules": [
        "Apply as decorative watermark, not as business content."
      ]
    },
    {
      "id": "role-art",
      "component": "Image",
      "accepts": [
        "role-art"
      ],
      "required": false,
      "rules": [
        "Visible role art belongs in the media slot.",
        "Do not leave it only in asset inventory."
      ]
    },
    {
      "id": "large-media",
      "component": "HeroHeader/Swiper/Image",
      "accepts": [
        "hero-background",
        "media-image"
      ],
      "required": true,
      "rules": [
        "Use asymmetric radius only here.",
        "Keep image ratio and crop intentionally."
      ]
    },
    {
      "id": "selected-state-asset",
      "component": "Tabs/Button",
      "accepts": [
        "selected-bg",
        "active-state"
      ],
      "required": false,
      "rules": [
        "Selected state is explicit; do not make it an invisible color-only change."
      ]
    }
  ],
  "assets": [
    {
      "id": "re1999-page-texture",
      "role": "section-background",
      "source": "/assets/brand-assets/re1999/img/BG2.png",
      "usage": "Archive page texture and dark panel atmosphere.",
      "fit": "cover or scoped overlay by page context",
      "status": "vendored"
    },
    {
      "id": "re1999-hero-background",
      "role": "hero-background",
      "source": "/assets/brand-assets/re1999/img/BG.png",
      "usage": "Hero or large archive media background.",
      "fit": "cover with intentional crop",
      "status": "vendored"
    },
    {
      "id": "re1999-logo-watermark",
      "role": "brand-mark",
      "source": "/assets/re1999-logo.png",
      "usage": "Navigation watermark or style switcher icon.",
      "fit": "contain",
      "status": "vendored"
    },
    {
      "id": "re1999-font-package",
      "role": "font",
      "source": [
        "/assets/brand-assets/re1999/font/Serif.ttf",
        "/assets/brand-assets/re1999/font/Sans.ttf",
        "/assets/brand-assets/re1999/font/Didot.ttf"
      ],
      "usage": "Serif, sans and display typography package.",
      "fit": "local @font-face with fallback",
      "status": "vendored"
    },
    {
      "id": "re1999-role-art-character1",
      "role": "role-art",
      "source": "/assets/brand-assets/re1999/img/character/1.png",
      "usage": "Role media image slot.",
      "fit": "contain bottom",
      "status": "vendored"
    },
    {
      "id": "re1999-selected-icon-pair",
      "role": "selected-bg",
      "source": [
        "/assets/brand-assets/re1999/img/icon/b.png",
        "/assets/brand-assets/re1999/img/icon/bc.png"
      ],
      "usage": "Default and active state image pair.",
      "fit": "state-scoped background image",
      "status": "vendored"
    }
  ],
  "layoutRules": {
    "sectionBackgroundChain": {
      "mode": "archive-layered-surfaces",
      "layers": [
        {
          "id": "re1999-page-shell",
          "assetId": "re1999-page-texture",
          "zIndex": 0,
          "placement": "page and major section background",
          "rule": "Texture sits behind content; content keeps its own readable foreground layer."
        },
        {
          "id": "re1999-hero-shell",
          "assetId": "re1999-hero-background",
          "zIndex": 1,
          "placement": "hero or large media slot",
          "rule": "Hero background must not become a repeated page texture."
        }
      ]
    },
    "imageFit": {
      "default": "preserve-source-ratio",
      "hero": "cover with intentional crop",
      "thumbnail": "object-fit: cover; stable aspect-ratio",
      "forbidden": [
        "stretching raster assets",
        "using generic shadows as a replacement for frame evidence"
      ]
    },
    "overlay": {
      "inspectorTag": {
        "mustNotAffectLayout": true,
        "position": "absolute",
        "rule": "Inspector labels and hover outlines never reserve height or resize media."
      }
    },
    "bottomBarReserve": {
      "required": true,
      "minPadding": "calc(bottom-bar-height + safe-area + 24px)",
      "rule": "Scrollable pages must reveal final cards above bottom navigation."
    }
  },
  "platformOverrides": {
    "h5": {
      "cssImport": "Theme CSS should be imported from a non-scoped or JS entry layer when scoped styles override it.",
      "font": "Vendored font files are preferred over public-path imports that PostCSS may parse as CSS."
    },
    "miniProgram": {
      "asset": "Use local bundled assets or approved CDN paths.",
      "style": "Inline style locks must be tokenized in source when CSS cannot override them."
    }
  },
  "verification": {
    "requiredGates": [
      "schema-valid",
      "computed-style-diff",
      "selector-hit-check",
      "asset-load-check",
      "no-generic-shadow-check",
      "bottom-bar-scroll-check"
    ],
    "previewLevel": "standard-demo-style-pack",
    "notes": "1999 is the sample that proves shadow/radius/frame must be evidence-driven and scoped, not globally guessed."
  },
  "semanticRoles": {
    "surface.page": {
      "kind": "mappedToken",
      "value": "#000000",
      "target": "--du-bg-2",
      "dtcgPath": "mapped.du-bg-2",
      "status": "mapped",
      "usage": "App/page base surface.",
      "sources": [
        "tokens.mapped.--du-bg-2"
      ],
      "evidence": [
        "dark site canvas"
      ]
    },
    "surface.card": {
      "kind": "mappedToken",
      "value": "#131818",
      "target": "--du-bg-1",
      "dtcgPath": "mapped.du-bg-1",
      "status": "mapped",
      "usage": "Readable content card surface.",
      "sources": [
        "tokens.mapped.--du-bg-1"
      ],
      "evidence": [
        "archive panel surface"
      ]
    },
    "text.primary": {
      "kind": "mappedToken",
      "value": "#E9DCCD",
      "target": "--du-text-1",
      "dtcgPath": "mapped.du-text-1",
      "status": "mapped",
      "usage": "Primary readable text.",
      "sources": [
        "tokens.mapped.--du-text-1"
      ],
      "evidence": [
        "warm paper foreground"
      ]
    },
    "text.secondary": {
      "kind": "mappedToken",
      "value": "#BBA893",
      "target": "--du-text-2",
      "dtcgPath": "mapped.du-text-2",
      "status": "mapped",
      "usage": "Secondary supporting copy.",
      "sources": [
        "tokens.mapped.--du-text-2"
      ],
      "evidence": [
        "muted archive copy"
      ]
    },
    "text.tertiary": {
      "kind": "mappedToken",
      "value": "#BBA893",
      "target": "--du-text-3",
      "dtcgPath": "mapped.du-text-3",
      "status": "mapped",
      "usage": "Weak labels and tertiary metadata.",
      "sources": [
        "tokens.mapped.--du-text-3"
      ],
      "evidence": [
        "muted archive copy"
      ]
    },
    "border.subtle": {
      "kind": "mappedToken",
      "value": "#45392F",
      "target": "--du-border-1",
      "dtcgPath": "mapped.du-border-1",
      "status": "mapped",
      "usage": "Default divider and subtle frame.",
      "sources": [
        "tokens.mapped.--du-border-1"
      ],
      "evidence": [
        "plain divider and panel line"
      ]
    },
    "shape.card.radius": {
      "kind": "styleOnlyToken",
      "value": "0px",
      "target": "--style-card-radius",
      "dtcgPath": "styleOnly.style-card-radius",
      "status": "mapped",
      "usage": "Primary content-card radius.",
      "sources": [
        "tokens.styleOnly.--style-card-radius"
      ],
      "evidence": [
        "Archival frame geometry is straight-edged."
      ]
    },
    "shape.control.radius": {
      "kind": "styleOnlyToken",
      "value": "42px",
      "target": "--style-control-radius",
      "dtcgPath": "styleOnly.style-control-radius",
      "status": "mapped",
      "usage": "Action/control radius.",
      "sources": [
        "tokens.styleOnly.--style-control-radius"
      ],
      "evidence": [
        "Pill controls are separate from card and media frame geometry."
      ]
    },
    "elevation.card.shadow": {
      "kind": "styleOnlyToken",
      "value": "none",
      "target": "--style-card-shadow",
      "dtcgPath": "styleOnly.style-card-shadow",
      "status": "mapped",
      "usage": "Card or lifted-surface shadow treatment.",
      "sources": [
        "tokens.styleOnly.--style-card-shadow"
      ],
      "evidence": [
        "Evidence says do not add generic shadow; use copper border or asset frame instead."
      ]
    },
    "action.primary.fill": {
      "kind": "mappedTokenFallback",
      "value": "#B55829",
      "target": "--du-primary-color",
      "dtcgPath": "mapped.du-primary-color",
      "status": "mapped",
      "usage": "Fallback primary action fill when no action-evidence sample exists yet; replace with actionEvidence once computed CTA sampling is available.",
      "sources": [
        "tokens.mapped.--du-primary-color"
      ],
      "evidence": [
        "copper emphasis"
      ],
      "protocol": {
        "source": "fallback-from-mapped-primary",
        "reason": "action-evidence-missing"
      }
    },
    "action.primary.token": {
      "kind": "mappedToken",
      "value": "#B55829",
      "target": "--du-primary-color",
      "dtcgPath": "mapped.du-primary-color",
      "status": "mapped",
      "usage": "Current demo-consumed CTA token; compare this with action.primary.fill to detect drift.",
      "sources": [
        "tokens.mapped.--du-primary-color"
      ],
      "evidence": [
        "copper emphasis"
      ]
    }
  }
}
