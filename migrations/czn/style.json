{
  "name": "czn",
  "schemaVersion": 1,
  "source": {
    "type": "web+screenshot",
    "url": "https://czn.qq.com/",
    "evidence": [
      "migrations/czn/brand-evidence.json",
      "migrations/czn/dangoui-adapter.json",
      "migrations/czn/component-mapping.json"
    ],
    "note": "Current evidence is based on user-provided screenshots because the site could not be resolved in the local environment."
  },
  "document": {
    "id": "style:czn",
    "name": "CZN Brand Style",
    "type": "DOCUMENT",
    "children": [
      {
        "id": "page:czn-home",
        "name": "CZN / 官网首页",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:czn:home:hero",
            "name": "Hero / 沉浸主视觉",
            "type": "FRAME",
            "absoluteBoundingBox": {
              "x": 0,
              "y": 0,
              "width": 375,
              "height": 320
            },
            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.page.darkImmersive}"
              },
              {
                "type": "GRADIENT_RADIAL",
                "name": "orange and purple character energy"
              }
            ],
            "strokes": [],
            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "immersive-hero-visual",
                "migrationIntent": "full-bleed-character-stage",
                "targets": {
                  "dangoui": {
                    "component": "Hero"
                  },
                  "vue": {
                    "component": "section"
                  },
                  "unocss": {
                    "shortcut": "czn-immersive-hero"
                  }
                }
              }
            }
          },
          {
            "id": "web:czn:home:primary-cta",
            "name": "Button / 橙色主行动",
            "type": "INSTANCE",
            "componentId": "dangoui:Button",
            "componentProperties": {
              "type": {
                "value": "primary",
                "type": "VARIANT"
              },
              "state": {
                "value": "default",
                "type": "VARIANT"
              }
            },
            "boundVariables": {
              "solidBg": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.action.orange}"
              },
              "border": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.action.orange}"
              }
            },
            "children": []
          }
        ]
      },
      {
        "id": "page:czn-forward",
        "name": "CZN / 公测内容",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:czn:forward:carousel-card",
            "name": "Swiper / 公测内容轮播",
            "type": "FRAME",
            "absoluteBoundingBox": {
              "x": 0,
              "y": 0,
              "width": 343,
              "height": 228
            },
            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.surface.darkHud}"
              },
              {
                "type": "IMAGE",
                "imageRef": "asset:czn:forward-mask",
                "scaleMode": "FILL"
