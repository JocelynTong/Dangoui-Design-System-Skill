            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.page.darkImmersive}"
              },
              {
                "type": "GRADIENT_RADIAL",
                "name": "purple red character glow"
              }
            ],
            "strokes": [],
            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "character-art-stage",
                "migrationIntent": "use-artwork-and-energy-backdrop-as-primary-style",
                "targets": {
                  "dangoui": {
                    "component": "CharacterPanel"
                  },
                  "vue": {
                    "component": "section"
                  },
                  "unocss": {
                    "shortcut": "czn-character-stage"
                  }
                }
              }
            }
          },
          {
            "id": "web:czn:character:selector",
            "name": "Avatar / 角色选择器",
            "type": "INSTANCE",
            "componentId": "dangoui:Avatar",
            "componentProperties": {
              "state": {
                "value": "selected",
                "type": "VARIANT"
              }
            },
            "boundVariables": {
              "selectedBorder": {
                "type": "VARIABLE_ALIAS",
                "id": "{color.action.orange}"
              }
            },
            "children": []
          }
        ]
      }
    ]
