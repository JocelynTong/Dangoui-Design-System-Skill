          "id": "page:czn-home",
          "sourceNavigation": [
            "官网首页",
            "前瞻情报",
            "角色档案",
            "图像资料"
          ],
          "selectedPagesReason": "当前 CZN demo 选择首页、前瞻情报、角色档案、媒体资料，是为了覆盖已采集到的主视觉、情报轮播遮罩、角色舞台和图像资料；不是所有参考站都必须复用这组栏目。",
          "scenarioRole": "home-distribution",
          "distributionSide": [
            "official-site",
            "public-test",
            "characters",
            "media"
          ],
          "displaySide": [
            "full-bleed-character-stage",
            "orange-primary-cta",
            "dark-hud-entry"
          ],
          "interactiveStates": [
            "button.hover",
            "entry.active"
