            "strokes": [
              {
                "type": "SOLID",
                "boundVariable": "{color.action.orange}"
              }
            ],
            "cornerRadius": 0,
            "children": [],
            "pluginData": {
              "echo.brand": {
                "assetRole": "slanted-hud-card",
                "migrationIntent": "forward-mask-clips-slide-image-and-replaces-default-card-border",
                "targets": {
                  "dangoui": {
                    "component": "Swiper"
                  },
                  "vue": {
                    "component": "DuCard"
                  },
                  "unocss": {
                    "shortcut": "czn-hud-frame"
                  }
                }
              }
            }
          },
          {
            "id": "web:czn:forward:light-news",
            "name": "Card / 浅灰资讯区",
            "type": "FRAME",
            "fills": [
              {
                "type": "SOLID",
                "boundVariable": "{color.surface.lightNews}"
              }
            ],
            "strokes": [],
            "cornerRadius": 0,
            "children": []
          }
        ]
      },
      {
        "id": "page:czn-character",
        "name": "CZN / 角色详情",
        "type": "CANVAS",
        "children": [
          {
            "id": "web:czn:character:stage",
            "name": "CharacterPanel / 角色展示舞台",
            "type": "FRAME",
            "absoluteBoundingBox": {
              "x": 0,
              "y": 0,
              "width": 343,
              "height": 300
