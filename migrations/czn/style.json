            "plain-dark-dashboard",
            "rounded-generic-card"
          ]
        },
        {
          "id": "page:czn-forward",
          "sourceNavigation": [
            "前瞻情报",
            "内容轮播",
            "活动卡片"
          ],
          "selectedPagesReason": "CZN 已有情报轮播 mask 和橙色焦点边框证据，因此单独保留前瞻/情报页验证媒体框。",
